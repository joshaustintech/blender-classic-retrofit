# Native macOS dependencies live outside the source tree.
SET(BLENDER_DEPENDENCY_PREFIX "" CACHE PATH "Private native dependency prefix")
LIST(PREPEND CMAKE_PREFIX_PATH "${BLENDER_DEPENDENCY_PREFIX}")
FIND_PATH(PYTHON_INC Python.h PATHS "${BLENDER_DEPENDENCY_PREFIX}/include/python2.5" NO_DEFAULT_PATH REQUIRED)
FIND_LIBRARY(PYTHON_LIB python2.5 PATHS "${BLENDER_DEPENDENCY_PREFIX}/lib/python2.5/config" NO_DEFAULT_PATH REQUIRED)
FIND_PROGRAM(PYTHON_BINARY python2.5 PATHS "${BLENDER_DEPENDENCY_PREFIX}/bin" NO_DEFAULT_PATH REQUIRED)
EXECUTE_PROCESS(COMMAND "${PYTHON_BINARY}" -c "import sys; assert sys.version_info[:2] == (2, 5)" RESULT_VARIABLE PYTHON_VERSION_STATUS)
IF(NOT PYTHON_VERSION_STATUS EQUAL 0)
  MESSAGE(FATAL_ERROR "The native build requires Python 2.5")
ENDIF()
SET(PYTHON_LINKFLAGS "")
SET(PYTHON_LIBPATH "")
FIND_PATH(SDL_INC SDL.h PATHS "${BLENDER_DEPENDENCY_PREFIX}/include/SDL" /opt/homebrew/include/SDL REQUIRED)
FIND_FILE(SDL_STATIC_LIB libSDL.a PATHS "${BLENDER_DEPENDENCY_PREFIX}/lib" NO_DEFAULT_PATH)
IF(SDL_STATIC_LIB)
  SET(SDL_LIB "${SDL_STATIC_LIB}")
ELSE()
  FIND_LIBRARY(SDL_LIB SDL REQUIRED)
ENDIF()
FIND_PATH(JPEG_INC jpeglib.h REQUIRED)
FIND_FILE(JPEG_STATIC_LIB libjpeg.a PATHS /opt/homebrew/opt/jpeg-turbo/lib /opt/homebrew/lib "${BLENDER_DEPENDENCY_PREFIX}/lib" NO_DEFAULT_PATH)
IF(JPEG_STATIC_LIB)
  SET(JPEG_LIB "${JPEG_STATIC_LIB}")
ELSE()
  FIND_LIBRARY(JPEG_LIB jpeg REQUIRED)
ENDIF()
FIND_PATH(PNG_INC png.h REQUIRED)
FIND_FILE(PNG_STATIC_LIB libpng.a PATHS /opt/homebrew/opt/libpng/lib /opt/homebrew/lib "${BLENDER_DEPENDENCY_PREFIX}/lib" NO_DEFAULT_PATH)
IF(PNG_STATIC_LIB)
  SET(PNG_LIB "${PNG_STATIC_LIB}")
ELSE()
  FIND_LIBRARY(PNG_LIB png REQUIRED)
ENDIF()
FIND_PATH(TIFF_INC tiffio.h REQUIRED)
FIND_LIBRARY(TIFF_LIBRARY tiff REQUIRED)
GET_FILENAME_COMPONENT(TIFF_RUNTIME_FILE "${TIFF_LIBRARY}" REALPATH)
GET_FILENAME_COMPONENT(TIFF_RUNTIME_NAME "${TIFF_RUNTIME_FILE}" NAME)
SET(TIFF_BUNDLE_PATH "@executable_path/${TIFF_RUNTIME_NAME}")
FIND_PATH(FREETYPE_HEADER ft2build.h PATH_SUFFIXES freetype2 REQUIRED)
SET(FREETYPE_INC "${FREETYPE_HEADER}")
FIND_FILE(FREETYPE_STATIC_LIB libfreetype.a PATHS "${BLENDER_DEPENDENCY_PREFIX}/lib" NO_DEFAULT_PATH)
IF(FREETYPE_STATIC_LIB)
  SET(FREETYPE_LIBRARY "${FREETYPE_STATIC_LIB}")
ELSE()
  FIND_LIBRARY(FREETYPE_LIBRARY freetype REQUIRED)
ENDIF()
# FreeType's native static build uses the platform compression libraries.
SET(FREETYPE_LIB "${FREETYPE_LIBRARY}" z bz2)
IF(WITH_INTERNATIONAL)
  FIND_PATH(GETTEXT_INC libintl.h REQUIRED)
  FIND_FILE(GETTEXT_STATIC_LIB libintl.a PATHS /opt/homebrew/opt/gettext/lib /opt/homebrew/lib "${BLENDER_DEPENDENCY_PREFIX}/lib" NO_DEFAULT_PATH)
  IF(GETTEXT_STATIC_LIB)
    SET(GETTEXT_LIBRARY "${GETTEXT_STATIC_LIB}")
  ELSE()
    FIND_LIBRARY(GETTEXT_LIBRARY intl REQUIRED)
  ENDIF()
  SET(GETTEXT_LIB "${GETTEXT_LIBRARY}" iconv)
ENDIF()
IF(WITH_OPENAL)
  FIND_PACKAGE(OpenAL REQUIRED)
  SET(OPENAL_LIB "${OPENAL_LIBRARY}")
  SET(OPENAL_INC "${OPENAL_INCLUDE_DIR}")
ENDIF()
SET(ZLIB_LIB z)
SET(LLIBS "")
SET(PLATFORM_CFLAGS "-pipe -fPIC -funsigned-char -fno-strict-aliasing -DXP_UNIX")
SET(PLATFORM_LINKFLAGS "-framework Cocoa -framework OpenGL -framework CoreServices -framework IOKit -framework AudioUnit -framework AudioToolbox -framework CoreAudio")
SET(CMAKE_BUILD_RPATH "@executable_path")
FIND_PROGRAM(PYTHON3_BINARY python3 REQUIRED)
GET_FILENAME_COMPONENT(SDL_LIBRARY_DIR "${SDL_LIB}" DIRECTORY)
GET_FILENAME_COMPONENT(TIFF_LIBRARY_DIR "${TIFF_LIBRARY}" DIRECTORY)
SET(BLENDER_RUNTIME_LIBRARY_DIRS "${SDL_LIBRARY_DIR}" "${TIFF_LIBRARY_DIR}")
SET(EXETYPE MACOSX_BUNDLE)
IF(WITH_QUICKTIME)
  MESSAGE(FATAL_ERROR "QuickTime requires a native replacement; its framework is unavailable in modern macOS")
ENDIF()
IF(WITH_OPENEXR)
  FIND_PATH(OPENEXR_INC ImfXdr.h PATH_SUFFIXES OpenEXR REQUIRED)
  FIND_LIBRARY(OPENEXR_LIBRARY IlmImf REQUIRED)
  SET(OPENEXR_LIB "${OPENEXR_LIBRARY}" Iex Half Imath IlmThread)
ENDIF()
IF(WITH_FFMPEG)
  FIND_PATH(FFMPEG_INC avformat.h PATH_SUFFIXES ffmpeg REQUIRED)
  FIND_LIBRARY(FFMPEG_AVFORMAT avformat REQUIRED)
  FIND_LIBRARY(FFMPEG_AVCODEC avcodec REQUIRED)
  FIND_LIBRARY(FFMPEG_AVUTIL avutil REQUIRED)
  SET(FFMPEG_LIB "${FFMPEG_AVFORMAT}" "${FFMPEG_AVCODEC}" "${FFMPEG_AVUTIL}")
ENDIF()
